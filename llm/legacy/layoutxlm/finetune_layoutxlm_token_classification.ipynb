    "def unnormalize_box(bbox, width, height):\n",
    "     return [\n",
    "         width * (bbox[0] / 1000),\n",
    "         height * (bbox[1] / 1000),\n",
    "         width * (bbox[2] / 1000),\n",
    "         height * (bbox[3] / 1000),\n",
    "     ]\n",
    "\n",
    "draw = ImageDraw.Draw(image_to_verify)\n",
    "for bbox in batch['bbox'][0]:\n",
    "    \n",
    "    draw.rectangle(unnormalize_box(bbox.asnumpy(), width=224, height=224), outline='red', width=1)\n",
